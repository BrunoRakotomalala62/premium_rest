# ---- CodeCraft upstream (REQUIRED) ----
# Votre clé API CodeCraft (commence par cc_). À définir dans Vercel, jamais commitée.
CODECRAFT_API_KEY=cc_your_key_here

# ---- Rotation de clés API (RECOMMANDÉ si vous avez plusieurs clés) ----
# Ajoutez plusieurs clés CodeCraft : dès qu'une clé est épuisée (quota) ou refusée
# (401/402/403/429), l'API bascule automatiquement sur la clé suivante.
# Ordre de lecture (doublons ignorés) :
#   1) CODECRAFT_API_KEY / CODECRAFT_KEY
#   2) CODECRAFT_API_KEYS (liste séparée par des virgules ou des retours à la ligne)
#   3) CODECRAFT_API_KEY_1, CODECRAFT_API_KEY_2, ... (jusqu'à CODECRAFT_KEYS_MAX, défaut 50)
# Exemples :
#   CODECRAFT_API_KEYS=cc_key1,cc_key2,cc_key3
#   CODECRAFT_API_KEY_1=cc_key1
#   CODECRAFT_API_KEY_2=cc_key2
# Santé des clés : GET /api/keys (labels masqués, aucune clé exposée).
# Stratégie : "failover" (défaut — reste sur la dernière clé qui marche) ou
#            "round-robin" (répartit la charge pour consommer les quotas en parallèle).
KEY_STRATEGY=failover
# Durées de mise à l'écart d'une clé après échec (ms) — ajustables :
# KEY_COOLDOWN_QUOTA_MS=3600000     # quota épuisé : 1 h
# KEY_COOLDOWN_INVALID_MS=1800000   # clé invalide/révoquée : 30 min
# KEY_COOLDOWN_RATE_MS=60000        # rate limit passager : 1 min
# KEY_COOLDOWN_FORBIDDEN_MS=900000  # 403 indéterminé : 15 min

CODECRAFT_BASE_URL=https://codecraftapi.com/v1
UPSTREAM_TIMEOUT_MS=55000
# CodeCraft est derrière Cloudflare : un User-Agent navigateur est indispensable
# depuis les IP datacenter (Vercel). Laisser vide = UA navigateur par défaut.
# CODECRAFT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/126.0.0.0 Safari/537.36

# ---- Modèles par défaut ----
DEFAULT_MODEL=claude-opus-5
VISION_DEFAULT_MODEL=claude-opus-5

# ---- Mémoire de conversation ----
# Nombre max de messages conservés par uid (user+assistant confondus)
MAX_HISTORY_MESSAGES=24
# Durée de vie d'une conversation, en secondes (86400 = 24h)
CONVERSATION_TTL_SECONDS=86400

# ---- Persistance durable de l'historique (RECOMMANDÉ sur Vercel) ----
# Sans ces variables, l'historique est en mémoire (perdu au cold start).
# Créez une base Upstash Redis (free tier) et collez les valeurs REST ici.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Sécurité optionnelle ----
# Si défini, les routes exigent x-api-token / Authorization: Bearer / ?token=
API_TOKEN=
# Origine CORS autorisée (défaut: *)
CORS_ORIGIN=*
